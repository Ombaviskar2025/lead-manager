# Copy to .env and adjust. Never commit the real .env file.
PORT=5000
NODE_ENV=development
# Use a long random string in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# SQLite file location (created automatically)
DB_PATH=data/leads.db
# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*
