# Copy to .env and adjust. Never commit the real .env file.
PORT=5000
NODE_ENV=development

# REQUIRED in production: a random string of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# SQLite file location (created automatically). In production point this at a PERSISTENT volume.
DB_PATH=data/leads.db

# Comma-separated list of allowed origins, or * for any (only matters if the UI is on another origin)
CORS_ORIGIN=*

# Session cookie. Defaults: Secure=true in production, SameSite=lax (single-origin deploys).
# COOKIE_SECURE=false      # only for testing production mode over plain http
# COOKIE_SAMESITE=none     # only if the UI is hosted on a different site (requires HTTPS)

# Set to 1 when behind a reverse proxy (Render, Railway, Fly, nginx) so rate limiting sees real client IPs
TRUST_PROXY=0

# Login/signup rate limit: max attempts per window per IP
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
